#version 460
//
// Wave-6 occlusion REGION raster (EXT dialect): one mesh workgroup per
// CPU-frustum-visible region draws its occupancy AABB as a watertight box
// against the live phase-A terrain depth (test GEQUAL reversed-Z, depth
// write OFF, color writes OFF); fragments that survive stamp the region's
// dispatch slot visible for this frame. Derived from Nvidium by MCRcortex
// (LGPL-3.0):
//   misc/reference/nvidium/.../shaders/occlusion/region_raster/mesh.glsl
//     (the 8-vert/12-tri cube emission with the PILUT index tables :19-37,
//      the 0.1-block box inflation :13,57-58, the camera-inside-region
//      forced-visible write :74-77)
// Alphadium's copy is byte-identical here (checked 2026-08-09), so raw
// Nvidium is the porting source for this file.
//
// EXT restructure (NVIDIUM-ARCHITECTURE.md §10 row 2): SetMeshOutputsEXT
// once, uniformly, BEFORE output writes; the NV flat 36-entry index array
// becomes the same 12 triangles as const uvec3s (triple j = flat[3j..3j+2]
// of NV's PILUTA..E interleave — re-derived and face-checked: each cube
// face appears as exactly 2 triangles, all 8 corners shared = watertight).
//
// CAMERA-INSIDE-BOX (the deliverable's "read how Nvidium handles it"):
// Nvidium does NOT clamp boxes to the near plane at all — standard
// primitive clipping handles boxes straddling it, and the one genuinely
// lost case (camera INSIDE the box: every wall is behind the camera or
// clipped away, zero fragments possible even though the region is
// trivially visible) is handled on the WRITE side — thread 0 force-stamps
// the region visible when the camera sits inside the inflated box
// (region_raster/mesh.glsl:74-77). No NV-specific trick is involved; this
// port keeps the scheme verbatim. The margins line up: the box is
// inflated 0.1 blocks and vanilla's near plane is 0.05, so a camera close
// enough to a wall for near-clipping to eat it is already INSIDE the
// inflated box and force-stamped.
//
// DIVERGENCES from the original, each deliberate:
//  - Region data comes from the per-frame OccRegions UBO (CPU-computed
//    occupancy AABB — the same min/max-occupied-position box Nvidium's
//    region record carries, RegionManager.java:95-126) instead of the GPU
//    region record: Meshelium's CPU store already knows the occupancy, and
//    this keeps the raster independent of the record buffers.
//  - Visibility is a frame STAMP (uint == FrameStamp means visible this
//    frame), not a 0/1 byte: no per-frame reset pass is needed (stale
//    slots hold an old stamp and compare unequal), and every writer of a
//    frame writes the identical value via atomicExchange — the
//    mesh-vs-fragment same-address race Nvidium ships (pre-write 0/1 in
//    the mesh, 1 in the fragment) is engineered out rather than assumed
//    benign on non-NV hardware.
//  - No region transform / originOffset (api0 is not ported).
//  - cullMode NONE in the pipeline (Nvidium relies on host GL cull state;
//    rasterizing both faces can only mark MORE visible — fail-open).

#extension GL_EXT_mesh_shader : require

layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 8, max_primitives = 12) out;

// The box index the fragment shader stamps with. Deliberately NOT
// gl_PrimitiveID: reading that in a fragment shader declares SPIR-V
// Capability Geometry, which needs a device feature vanilla does not
// enable, so box.frag would fail to compile on any driver that enforces it
// and occlusion would silently fall back. See box.frag for the full story.
layout(location = 0) perprimitiveEXT out uint vBoxId[];

// Per-frame occlusion region list (TerrainDrawer's occlusion path).
// Standard mode (MESHELIUM_LISTS_SSBO == 0): MESHELIUM_OCC_REGIONS × 32 B =
// 16 KiB = spec-min maxUniformBufferRange, out of vanilla's transient
// memory — byte-identical to wave 6. Extended render distance
// (MESHELIUM_LISTS_SSBO == 1, wave 10): an unsized read-only SSBO slice of
// MesheliumFrameLists' host-visible ring (transient memory cannot mint
// STORAGE usage — wave-3b finding); the vec4+uvec4 struct is 32 B under
// std140 AND std430, so the CPU byte layout is identical either way.
struct OccRegion {
    vec4 origin;   // xyz = region MIN corner in blocks, camera-relative
    uvec4 meta;    // x = regionId, y = compacted section count,
                   // z = occMin packed (x | y<<8 | z<<16, section-local),
                   // w = occMax packed
};
#if MESHELIUM_LISTS_SSBO
layout(set = 0, binding = 0, std430) readonly buffer OccRegions {
    OccRegion occRegions[];
};
#else
layout(set = 0, binding = 0, std140) uniform OccRegions {
    OccRegion occRegions[MESHELIUM_OCC_REGIONS];
};
#endif

// Meshelium's per-frame scene UBO (wave-5 layout, shared slice with the
// terrain pipelines — must match TerrainDrawer.uploadScene byte-for-byte).
layout(set = 0, binding = 1, std140) uniform MesheliumScene {
    mat4 ModelViewMat;
    vec4 SceneMisc;
    vec4 FrustumPlanes[6];
    ivec4 CameraChunk;
};

// Vanilla's own Projection UBO slice — same matrix the terrain draws use,
// so box depth and terrain depth come from IDENTICAL transforms.
layout(set = 0, binding = 2, std140) uniform Projection {
    mat4 ProjMat;
};

// Region visibility stamps, indexed by DISPATCH SLOT (this frame's list
// position, Nvidium's frustum-list-slot indexing — study §5).
layout(set = 0, binding = 3, std430) buffer StampOut {
    uint stampOut[];
};

layout(push_constant) uniform OccPush {
    uint FrameStamp;
};

// Nvidium's 0.1-block inflation (ADD_SIZE 0.1f/16 chunk units × 16).
const float BOX_INFLATE = 0.1;

// The 12 cube triangles, re-derived from NV's PILUTA..PILUTE flat array
// (triangle j = flat[3j], flat[3j+1], flat[3j+2]). Corner v encodes
// x = v&1, z = v&2, y = v&4 (low/high per bit) — the original's mapping.
const uvec3 BOX_TRIS[12] = uvec3[12](
    uvec3(0u, 1u, 2u), uvec3(1u, 3u, 2u),   // y = lo face
    uvec3(0u, 2u, 6u), uvec3(6u, 4u, 0u),   // x = lo face
    uvec3(0u, 4u, 5u), uvec3(5u, 1u, 0u),   // z = lo face
    uvec3(1u, 5u, 7u), uvec3(7u, 3u, 1u),   // x = hi face
    uvec3(4u, 6u, 7u), uvec3(7u, 5u, 4u),   // y = hi face
    uvec3(2u, 7u, 6u), uvec3(2u, 3u, 7u)    // z = hi face
);

void main() {
    uint slot = gl_WorkGroupID.x;   // draw count == list count, never out of range
    OccRegion e = occRegions[slot];

    uvec3 occMin = (e.meta.zzz >> uvec3(0u, 8u, 16u)) & uvec3(0xFFu);
    uvec3 occMax = (e.meta.www >> uvec3(0u, 8u, 16u)) & uvec3(0xFFu);
    vec3 lo = e.origin.xyz + vec3(occMin) * 16.0 - BOX_INFLATE;
    vec3 hi = e.origin.xyz + (vec3(occMax) + 1.0) * 16.0 + BOX_INFLATE;

    // Uniform by construction (every invocation reads the same entry).
    SetMeshOutputsEXT(8u, 12u);

    uint t = gl_LocalInvocationIndex;
    vec3 corner = vec3(
            ((t & 1u) == 0u) ? lo.x : hi.x,
            ((t & 4u) == 0u) ? lo.y : hi.y,
            ((t & 2u) == 0u) ? lo.z : hi.z);
    gl_MeshVerticesEXT[t].gl_Position = ProjMat * (ModelViewMat * vec4(corner, 1.0));

    gl_PrimitiveTriangleIndicesEXT[t] = BOX_TRIS[t];
    vBoxId[t] = slot;
    if (t < 4u) {
        gl_PrimitiveTriangleIndicesEXT[8u + t] = BOX_TRIS[8u + t];
        vBoxId[8u + t] = slot;
    }

    if (t == 0u) {
        // Camera inside the inflated box (coords are camera-relative, so
        // "inside" = the box contains the origin) → forced visible; same
        // value as the fragment writes, so ordering is irrelevant.
        if (all(lessThanEqual(lo, vec3(0.0))) && all(greaterThanEqual(hi, vec3(0.0)))) {
            atomicExchange(stampOut[slot], FrameStamp);
        }
    }
}
