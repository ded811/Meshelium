#version 460
#extension GL_EXT_mesh_shader : require

// Meshelium wave 2 — "hello meshlet", world-space variant.
//
// One 64-byte UBO: a CPU-composed MVP (projection * viewRotation *
// translate(anchor - cameraPos), all from CameraRenderState's public
// matrices — docs/VANILLA-FRAME-PATH.md Q6 step B). The triangle's local
// coordinates span one block; the anchor is latched once a few blocks in
// front of the camera on the first hello frame, so the triangle is
// world-anchored from then on. Pushed per frame via vkCmdPushDescriptorSetKHR
// out of vanilla's transient memory — no persistent buffers.
//
// Yellow, so it reads apart from the magenta NDC triangle in one screenshot.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;

layout(set = 0, binding = 0, std140) uniform HelloMvp {
    mat4 Mvp;
};

layout(location = 0) out vec4 mesheliumColor[];

void main() {
    SetMeshOutputsEXT(3u, 1u);

    // A one-block triangle standing upright on the anchor point.
    gl_MeshVerticesEXT[0].gl_Position = Mvp * vec4(0.0, 0.0, 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = Mvp * vec4(1.0, 0.0, 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = Mvp * vec4(0.5, 1.0, 0.0, 1.0);

    mesheliumColor[0] = vec4(1.0, 1.0, 0.0, 1.0);
    mesheliumColor[1] = vec4(1.0, 1.0, 0.0, 1.0);
    mesheliumColor[2] = vec4(1.0, 1.0, 0.0, 1.0);

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0u, 1u, 2u);
}
