#version 460
//
// Wave-6 occlusion SECTION raster, TASK stage (EXT dialect): one task
// workgroup per dispatched region gates on the region-raster verdict and
// launches one mesh workgroup per compacted section slot. Derived from
// Nvidium by MCRcortex (LGPL-3.0):
//   misc/reference/nvidium/.../shaders/occlusion/section_raster/task.glsl
//     (the regionVisibility early-out :38-43 and the count dispatch :52-61)
// with Alphadium's shape as the porting baseline where they diverge
// (project doctrine): Alphadium's task.glsl no longer writes the indirect
// command buffers here (that moved to its compute command_buffer_builder)
// — and Meshelium has no GPU-written command buffers at all (visibility is
// consumed by the SAME frame's phase-B task stage through stamp buffers,
// see TerrainOcclusion), so this stage is gate + dispatch only, exactly
// Alphadium's residue.
//
// EXT restructure: gl_TaskCountNV → EmitMeshTasksEXT(count,1,1) called
// exactly once in uniform control flow (single-invocation workgroup, so
// uniformity is trivial); taskNV block → taskPayloadSharedEXT variable.
//
// The dispatch count is the CPU's dense compacted-slot count (the wave-5
// dispatch invariant — tighter than Nvidium's GPU-side lastIdx+1; trailing
// slots hold zeroed records and the mesh stage's header.w==0 check retires
// any straggler, second line of defense).

#extension GL_EXT_mesh_shader : require

// Boxes per section-raster mesh workgroup on the Sodium host
// (TerrainOcclusion.ensureSodiumPipelines injects it from
// SodiumTerrainDrawer.OCC_BOXES_PER_WG; 1 = the original one-box
// workgroups, and the text under "> 1" is then not compiled, so every
// existing variant's SPIR-V is unchanged). Defaulted here so the
// standalone compiles, which never define it, stay well-formed.
#ifndef MESHELIUM_OCC_BOXES_PER_WG
#define MESHELIUM_OCC_BOXES_PER_WG 1
#endif

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#if MESHELIUM_SODIUM
// The Sodium host's 64-B list entry (D-023 stage 3; rationale in
// region_raster.mesh). meta.x is Meshelium's dense mid, meta.y the
// occupancy popcount = the mesh workgroups to launch: the section raster
// mesh stage maps workgroup k to the k-th occupied slot by prefix
// popcount over the region row, so no empty slot is ever dispatched.
struct OccRegion {
    vec4 origin;
    uvec4 meta;    // x = mid, y = popcount(occupancy), z/w = occ AABB
    uvec4 mask0;   // VisMode-0 BFS mask, never read here
    uvec4 mask1;
    uvec4 row0;    // SodiumGpuVisibilityLayout.LIST_ROW: the region's row,
    uvec4 row1;    // fresh every frame; row1/row2 are the occupancy this
    uvec4 row2;    // raster walks, handed to the mesh stage in the payload
    uvec4 row3;
};
#else
struct OccRegion {
    vec4 origin;   // xyz = region MIN corner in blocks, camera-relative
    uvec4 meta;    // x = regionId, y = compacted count, z/w = occ AABB
};
#endif
// Wave-10: same UBO-vs-SSBO split as region_raster.mesh (rationale +
// layout-equivalence note there).
#if MESHELIUM_LISTS_SSBO
layout(set = 0, binding = 0, std430) readonly buffer OccRegions {
    OccRegion occRegions[];
};
#else
layout(set = 0, binding = 0, std140) uniform OccRegions {
    OccRegion occRegions[MESHELIUM_OCC_REGIONS];
};
#endif

// Region visibility stamps written by the region raster last pass (the
// pass-end full barrier orders them — frame-path Q1.3's inherited
// invariant; indexed by dispatch slot).
// coherent (2026-09-22): written by the region raster earlier in this
// same frame and read here at a workgroup-uniform address - the shape RADV
// served stale for the mirror rows. A stale read skips the whole region's
// section raster, which is a whole-region hole.
layout(set = 0, binding = 4, std430) coherent readonly buffer RegionStamps {
    uint regionStamps[];
};

layout(push_constant) uniform OccPush {
    uint FrameStamp;
};

struct OccSectionPayload {
    vec3 origin;    // region MIN corner rel camera (blocks)
    uint regionId;  // Meshelium region id → section-record block index
#if MESHELIUM_SODIUM && MESHELIUM_OCC_BOXES_PER_WG > 1
    uint popcount;  // occupied slots of the region: the packed mesh
                    // stage clips its last workgroup's box count on it
#endif
#if MESHELIUM_SODIUM
    uvec4 occ0;     // the occupancy mask, from the list entry's fresh row:
    uvec4 occ1;     // the mesh stage used to read it from the mirror, and
                    // pairing a fresh popcount with a stale mask walked
                    // ranks the mask did not have
#endif
};
taskPayloadSharedEXT OccSectionPayload payload;

void main() {
    uint slot = gl_WorkGroupID.x;
    uint count = 0u;
    if (regionStamps[slot] == FrameStamp) {
        OccRegion e = occRegions[slot];
        payload.origin = e.origin.xyz;
        payload.regionId = e.meta.x;
#if MESHELIUM_SODIUM
        payload.occ0 = e.row1;
        payload.occ1 = e.row2;
#endif
#if MESHELIUM_SODIUM && MESHELIUM_OCC_BOXES_PER_WG > 1
        // ceil(popcount / boxes per workgroup) workgroups, each taking
        // the next MESHELIUM_OCC_BOXES_PER_WG ranks (2026-09-13: one
        // 8-lane workgroup per box left three quarters of every wave idle
        // and priced the raster by launches, not pixels).
        payload.popcount = e.meta.y;
        count = (e.meta.y + uint(MESHELIUM_OCC_BOXES_PER_WG) - 1u) / uint(MESHELIUM_OCC_BOXES_PER_WG);
#else
        count = e.meta.y;
#endif
    }
    EmitMeshTasksEXT(count, 1u, 1u);
}
