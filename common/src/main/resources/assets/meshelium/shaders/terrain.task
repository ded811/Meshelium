// Copyright (C) 2026 Ded811
// SPDX-License-Identifier: LGPL-3.0-only
#version 460
//
// Wave-5 opaque terrain TASK shader (EXT dialect). Per-section culling +
// facing-bucket bin building derived from Nvidium by MCRcortex (LGPL-3.0):
//   misc/reference/nvidium/.../shaders/terrain/task.glsl (per-section cull,
//   header decode :39-49)
//   misc/reference/nvidium/.../shaders/terrain/task_common.glsl (the
//   camera-side bucket walk :30-78 and the bin table payload :3-14)
// restructured for VK_EXT_mesh_shader per NVIDIUM-ARCHITECTURE.md §4/§10
// row 2: gl_TaskCountNV → one uniform EmitMeshTasksEXT(total,1,1) after a
// workgroup barrier; NV's one-invocation-per-workgroup shape becomes
// MESHELIUM_TASK_WG_SIZE sections per workgroup, one invocation each.
//
// DISPATCH SHAPE (docs/VANILLA-FRAME-PATH.md wave-5 notes): the CPU records
// one vkCmdDrawMeshTasksEXT(ceil(compactedCount / MESHELIUM_TASK_WG_SIZE),1,1)
// per CPU-frustum-visible region. Invocation t of workgroup w owns compacted
// section slot w*MESHELIUM_TASK_WG_SIZE+t of the region named by the push
// constants. Slots past the region's live count are dispatched only in the
// tail workgroup and hold all-zero records (RegionStore's trailing-zeros
// invariant), so the header.w==0 emptiness check retires them.
//
// WHAT GETS CULLED here, and why each cut is pixel-safe (the wave-5 bar:
// culling may only remove what was never visible):
//  (a) frustum — the six Gribb-Hartmann planes of the RENDER matrices
//      (ProjMat * ModelViewMat), extracted CPU-side with JOML
//      FrustumIntersection.set's exact formulas and tested with its exact
//      p-vertex >= -w rule (both bytecode-verified — the same class
//      vanilla's own Frustum wraps), against the section's full 16³ box
//      inflated by 0.5 blocks. Pixel-safety is the CLIP-VOLUME argument,
//      not frustum equality: every rendered pixel's geometry lies inside
//      the render clip volume; a box fully outside one of these planes
//      puts all its geometry outside that plane, so it contributes no
//      pixel. (Vanilla's own cull frustum is deliberately LOOSER — Camera
//      .createProjectionMatrixForCulling widens fov to max(fov, option
//      fov) with near 0.05 / far depthFar, bytecode-read — so ours culls
//      more, and only ever pixel-less boxes.)
//  (b) distance — vanilla applies NO draw-time distance test beyond its
//      cull frustum's far plane (depthFar enters only through that
//      projection; prepareChunkRenders iterates visibleSections with no
//      distance check), and the BFS visibility feed below is already
//      render-distance-bounded (SectionOcclusionGraph walks at most
//      renderDistance*16) — so (a)'s far plane + (c) subsume the
//      render-distance sphere; see the wave-5 notes.
//  (c) the visibility bitmask — bit posKey of the region's 256-bit mask,
//      built CPU-side each frame from vanilla's OWN visibleSections list
//      (the same-frame list vanilla's prepareChunkRenders drew from, read
//      on the render thread inside the same LevelRenderer.render call).
//      Vanilla draws EXACTLY visibleSections, so masking to it can only
//      remove sections vanilla itself would not have drawn. MaskSlot ==
//      0xFFFFFFFF means "no mask uploaded" (per-frame UBO overflow) and
//      fails OPEN: every section passes — culling degrades, parity never.
//  (d) facing buckets — the same camera-side gates the wave-4 CPU applied
//      (task_common.glsl:39-78 signs; a +X face at plane x=k is invisible
//      from camera x < k, i.e. only back-facing quads are dropped).
//
// PAYLOAD (fixed size by construction — the reference's own bin-table
// design): one MesheliumSectionTask per invocation. A literal per-mesh-group
// {base,count} array cannot be bounded — renderRanges carries u16 quad
// counts per bucket, so ONE section can legally demand thousands of mesh
// groups — and a capped array would need a drop path, which the parity bar
// forbids. Instead each mesh workgroup derives its quads from
// gl_WorkGroupID.x via two searches (section by cumulative groupEnd, quad
// by cumulative bin ends), exactly how Nvidium's mesh stage consumed
// binIa/binVa. 72 B/section × MESHELIUM_TASK_WG_SIZE (default 32) = 2304 B,
// far under the spec-guaranteed maxTaskPayloadSize >= 16384 and asserted
// against the real device's cap at pipeline creation.
//
// No subgroup ops anywhere: the one cross-invocation step (prefix-summing
// 32 group counts) is done by invocation 0 between barriers — portable to
// any subgroup size, revisit in wave 9 if profiling says so.
//
// ---- THE SODIUM ARM (MESHELIUM_SODIUM_TASK == 1, D-023 stages 2-3) ----
// Every declaration and the whole main() body below have a second arm
// that selects Sodium's geometry instead of Meshelium's. WHY: stage 0
// measured our per-section CPU enumeration at up to half the frame at
// aerial rd96 (MEASUREMENTS.md 0k); the stage-1 run cache removed most of
// it and left a GPU-bound frame (0l) whose pass scales with quads, not
// per-vertex ALU (0m); under the canopy the box rasters cut the
// standalone's draw by 0.256 ms for a 0.103 ms tax (0n). So the section
// selection moves here: the CPU writes one 64-byte list entry per LISTED
// REGION and one indirect command of ceil(popcount/32) workgroups, and
// this stage reads Sodium's 48-byte section records out of a DEVICE_LOCAL
// mirror (a verbatim memcpy of SectionRenderDataUnsafe's heap, committed
// in-stream before the frame's first opaque pass - contract §3) and does
// per lane what MesheliumSodiumDrawList.walkRegion/emitRuns did per
// section on the CPU. Layout literals below carry a
// "SodiumGpuVisibilityLayout.X" comment; that Java class is authoritative.
//
// Lane -> slot: lane k of this region maps to the k-th SET bit of the
// region row's 256-bit occupancy mask by prefix popcount (fewest fill
// workgroups: a region with 40 occupied slots dispatches 2 workgroups,
// not 8). Slot s is Sodium's LocalSectionIndex: x = (s>>5)&7, y = s&3,
// z = (s>>2)&7.
//
// The four gates, each with its parity argument (contract §6):
//  VisMode 0  the BFS-parity bit: bit slot of the list entry's mask,
//             drained from Sodium's own sectionsWithGeometryIterator for
//             this region - the drawn set equals the list path's exactly.
//  VisMode 1/2  the stamp tests of the standalone path, verbatim (below).
//  frustum    (VisMode 1/2 only) the same inflated-box test as the
//             standalone arm; VisMode 0's set already passed Sodium's
//             cull-frustum test, so it is drawn ungated (see the gate).
//  distance   (Flags & DIST_GATE, VisMode 1/2 only) OcclusionCuller
//             .visitNode's test with `precise` arithmetic so the float
//             ops match Java's fmul/fadd (no FMA contraction).
//  facing     DefaultChunkRenderer.getVisibleFaces as six integer
//             comparisons on CameraTransform.intX/Y/Z - exact parity,
//             checked against Sodium's method on a lattice every suite
//             run (MesheliumSodiumFacing.latticeFailure).
// The record walk is emitRuns line for line: seven runs in facing-list
// order, a zero-count run's facing byte never consulted, the VERTEX
// cursor advancing over every run including culled ones (D-010's trap),
// bins in vertex units because Sodium's base vertex need not be a
// multiple of four.
//
// Belt and braces (contract I4): a row whose bufferKey is not the bound
// geometry buffer's GroupKey emits nothing - a region in the wrong draw
// group can only be omitted, never read from the wrong buffer.
#extension GL_EXT_mesh_shader : require
#if MESHELIUM_SODIUM_TASK
// gl_DrawIDARB in the TASK stage: one indirect draw covers every listed
// region of one geometry buffer, and the draw index names the region's
// list slot. Verified legal with glslc + spirv-val (vulkan1.2) 2026-09-07
// rather than assumed; shaderDrawParameters and multiDrawIndirect are
// vanilla-enabled features (VulkanBackend.<clinit>).
#extension GL_ARB_shader_draw_parameters : require
#endif

layout(local_size_x = MESHELIUM_TASK_WG_SIZE, local_size_y = 1, local_size_z = 1) in;

// Meshelium's per-frame scene UBO (grown in wave 5; layout must match
// terrain.mesh/terrain.frag and TerrainDrawer.uploadScene byte-for-byte).
layout(set = 0, binding = 1, std140) uniform MesheliumScene {
    mat4 ModelViewMat;      // CameraRenderState.viewRotationMatrix
    vec4 SceneMisc;         // xy = block atlas size in texels
    vec4 FrustumPlanes[6];  // Gribb-Hartmann rows of ProjMat*ModelViewMat,
                            // camera-relative space, unnormalized (the
                            // p-vertex test is scale-invariant)
    ivec4 CameraChunk;      // xyz = camera section coords (blockPos >> 4)
    vec4 CullMisc;          // x = plant-cull distance squared (blocks²),
                            // y = sub-pixel-cull distance squared (mesh
                            // stage only), zw = viewport size in pixels
                            // (mesh stage only); a slider at 0 uploads
                            // 3.4e38, which every real distance compares
                            // under, so the gate keeps everything
#if MESHELIUM_SODIUM_TASK
    // The Sodium tail (SodiumTerrainDrawer.uploadScene grows 208 -> 240 B
    // on the rung-0 path only). SodiumGpuVisibilityLayout.SCENE_CAMERA_FRAC
    // (208) / SCENE_CAMERA_BLOCK (224).
    vec4 CameraFrac;        // xyz = CameraTransform.fracX/Y/Z, w = Sodium's
                            // search distance D in blocks (getSearchDistance)
    ivec4 CameraBlock;      // xyz = CameraTransform.intX/Y/Z verbatim (the
                            // d2i truncation getVisibleFaces was called with)
#endif
};

#if MESHELIUM_SODIUM_TASK
// ---- Sodium arm, bindings 7 and 8 (SodiumGpuVisibilityLayout.B_MIRROR /
// B_LIST). Exactly FOUR task-stage storage buffers on this pipeline
// (7, 8, 9, 10 - the spec minimum, TASK_STAGE_STORAGE_BUFFERS), which is
// why the stats live in the mirror's header instead of a fifth binding.
//
// The mirror (SodiumMirrorGpu), bound whole from offset 0: a 256-byte
// header, then capacity rows of 64 B, then the SOLID and CUTOUT record
// tables of capacity*256 records of 48 B each. Everything after the
// header is addressed as uvec4 data[]: row(mid) = data[mid*4 + 0..3],
// record(mid, slot) = data[RecordBase + (mid*256 + slot)*3 + 0..2] with
// RecordBase the push constant (= recordBaseUvec4(capacity, pass)).
//   row:    [0] ivec4 {chunkX, chunkY, chunkZ, flags (bit0 live)}
//           [1] uvec4 occupancy words 0-3   (bit s at word s>>5, bit s&31)
//           [2] uvec4 occupancy words 4-7
//           [3] uvec4 {bufferKey, popcount, occMinPacked, occMaxPacked}
//   record: Sodium's SectionRenderDataUnsafe bytes, verbatim:
//           w0 = {baseElement, baseVertex, facing bytes 0-3, facing bytes
//                 4-6 | isLocalIndex<<24}
//           w1 = {sliceMask, count0, count1, count2}
//           w2 = {count3, count4, count5, count6}
// stats[0..2] += 1 per surviving section in VisMode 0/1/2, stats[3] +=
// quads emitted (all modes): TerrainOcclusion.recordStatsTransfer reads
// them through the mirror. hdr[] is the layout words (debug/readback).
// coherent: every read of the mirror goes past the per-core caches to the
// device's coherence point. Added 2026-09-22 after the owner's RADV laptop
// showed rows served stale for many frames; the rows now come from the
// list (below), and this makes the 48-byte section records immune to the
// same thing at the cost of a cache level they rarely hit anyway.
layout(set = 0, binding = 7, std430) coherent buffer SodiumMirror {
    uint stats[24];     // SodiumGpuVisibilityLayout.MIRROR_STATS_OFFSET 0
                        // [0..2] survivors per VisMode, [3] quads,
                        // [4] region rejections, [5] of those a dead row,
                        // [6] of those a key mismatch, [7] VisMode of the
                        // first rejection, [8..18] what it saw,
                        // [19..23] mirror rows that disagreed with the
                        // list's fresh copy (STAT_MIRROR_STALE)
    uint hdr[40];       // MIRROR_LAYOUT_OFFSET 96 .. MIRROR_HEADER_BYTES 256
    uvec4 data[];       // byte 256 onward
};

// The per-frame list (SodiumFrameRing slot), one 64-B entry per LISTED
// region in draw order, written by MesheliumRegionMirror.buildFrame:
// SodiumGpuVisibilityLayout.LIST_ENTRY_BYTES / LIST_ORIGIN / LIST_META_* /
// LIST_BFS_MASK. Entry FirstSlot + gl_DrawIDARB is this draw's region.
struct OccRegion {
    vec3 origin;    // region MIN corner rel camera (blocks)
    uint groupEnd;  // SodiumGpuVisibilityLayout.LIST_GROUP_END: cumulative task
                    // workgroups of this entry's group through this entry    // xyz = region MIN corner in blocks, camera-relative
    uvec4 meta;     // x = mid, y = popcount(occupancy), z/w = occ AABB packed
    uvec4 mask0;    // 256-bit BFS mask, slots 0-127 (VisMode 0 only)
    uvec4 mask1;    // slots 128-255
    // SodiumGpuVisibilityLayout.LIST_ROW: the region's row, rewritten by
    // the processor every frame, in the mirror row's layout. Read instead
    // of the mirror's copy (FLAG_ROWS_FROM_LIST), which RADV served stale.
    uvec4 row0;     // {chunkX, chunkY, chunkZ, flags}
    uvec4 row1;     // occupancy words 0-3
    uvec4 row2;     // occupancy words 4-7
    uvec4 row3;     // {bufferKey, popcount, occMin, occMax}
};
layout(set = 0, binding = 8, std430) readonly buffer SodiumList {
    OccRegion list[];
};
#else
// The wave-3 section-record buffer (MesheliumTerrainGpu.sectionBuffer): 256
// records of 32 B per region id, i.e. two ivec4 per record —
// [0] = header, [1] = renderRanges (layout: SectionRecord javadoc /
// docs/TERRAIN-DATA.md §3).
layout(set = 0, binding = 7, std430) readonly buffer SectionRecords {
    ivec4 sectionRecords[];
};

// Per-frame visibility masks: 256 bits (= 2 uvec4) per DISPATCHED region,
// slice-indexed by the MaskSlot push constant. Read ONLY when VisMode ==
// 0 (the wave-5 BFS feed / the meshelium.terrainDraw.bfsOnly fallback);
// occlusion frames bind a dummy slice here that is never dynamically
// accessed. Two bindings since wave 10:
//  - MESHELIUM_LISTS_SSBO == 0 (standard, configured max RD = 32): a UBO,
//    because vanilla's transient memory cannot mint STORAGE usage
//    (wave-3b bytecode finding); the declared array is the fixed 16 KiB
//    the spec-minimum maxUniformBufferRange guarantees — byte-identical
//    to every wave since 5.
//  - MESHELIUM_LISTS_SSBO == 1 (extended render distance): a read-only
//    SSBO slice of Meshelium's own host-visible ring (MesheliumFrameLists) —
//    unsized array, so ONE pipeline serves any pinned capacity; uvec4
//    stride is 16 B under std140 AND std430, so the CPU byte layout is
//    unchanged.
#if MESHELIUM_LISTS_SSBO
layout(set = 0, binding = 8, std430) readonly buffer VisibilityMasks {
    uvec4 visMasks[];
};
#else
layout(set = 0, binding = 8, std140) uniform VisibilityMasks {
    uvec4 visMasks[MESHELIUM_VIS_UVEC4S];
};
#endif
#endif

// ---- wave-6 occlusion visibility (read ONLY when VisMode != 0; bfs/cpu
// frames bind a harmless dummy SSBO that is never dynamically accessed).
// Frame-stamped ping-pong buffers, one uint per global section slot
// (regionId*256 + compactedSlot): a slot is "marked in frame F" iff the
// buffer whose parity is F holds exactly F at that index. PrevStamps is
// the buffer the LAST frame's section raster wrote; CurStamps is the one
// THIS frame's raster wrote (pass 3, before phase B reads it in pass 4 —
// vanilla's pass-end full barrier orders the two). Semantics map 1:1 to
// the byte Nvidium consumes: bit0 == (cur == FrameStamp), bit1 == (prev
// == FrameStamp-1); see occlusion/section_raster.mesh for why the byte
// itself was replaced (cross-stage same-address store race).
// coherent (2026-09-22): the stamps are written by the GPU a frame or a
// pass earlier and read at the same addresses every frame, the exact shape
// that RADV served stale for the mirror rows; a coherent read skips the
// per-core caches.
layout(set = 0, binding = 9, std430) coherent readonly buffer PrevStamps {
    uint prevStamps[];
};
layout(set = 0, binding = 10, std430) coherent readonly buffer CurStamps {
    uint curStamps[];
};
#if MESHELIUM_SODIUM_TASK
// No binding 11 on the Sodium arm: the stats are the mirror header's
// first four words (binding 7), keeping the task stage at four storage
// buffers.

// Per-draw data: one indirect draw = every listed region of one geometry
// buffer; the draw index selects the region. 32 B, TASK|MESH, offsets per
// SodiumGpuVisibilityLayout.PUSH_*; the mesh stage reads none of it.
layout(push_constant) uniform MesheliumPush {
    uint FirstSlot;        // PUSH_FIRST_SLOT 0: list index of this draw's
                           // first region (groupStart[g])
    uint GroupKey;         // PUSH_GROUP_KEY 4: bufferKey of the geometry
                           // buffer bound at binding 0 for this draw
    uint VisMode;          // PUSH_VIS_MODE 8: 0 BFS-parity mask / 1 phase A
                           // / 2 phase B (VIS_MODE_*)
    uint FrameStamp;       // PUSH_FRAME_STAMP 12: the owned frame's stamp
    uint Flags;            // PUSH_FLAGS 16: FLAG_STATS 1, FLAG_FACE_ALL 2,
                           // FLAG_DIST_GATE 4
    uint RecordBase;       // PUSH_RECORD_BASE 20: uvec4 index of this
                           // pass's record table inside data[]
    uint RegionCount;      // PUSH_REGION_COUNT 24: this draw's list-entry
                           // count (FLAG_ONE_DRAW), else 0
    uint RecordPass;       // PUSH_RECORD_PASS 28: 0 = RecordBase is the SOLID
                           // table, 1 = CUTOUT (which record probe to use)
};
const uint SODIUM_FLAG_STATS     = 1u;   // SodiumGpuVisibilityLayout.FLAG_STATS
const uint SODIUM_FLAG_FACE_ALL  = 2u;   // SodiumGpuVisibilityLayout.FLAG_FACE_ALL
const uint SODIUM_FLAG_DIST_GATE = 4u;   // SodiumGpuVisibilityLayout.FLAG_DIST_GATE
// Measurement only (SodiumTerrainDrawer.PROPERTY_DIAG_TASK_SKIP): never
// set by a shipped path; see SodiumGpuVisibilityLayout.FLAG_DIAG_*.
const uint SODIUM_FLAG_DIAG_SKIP_ALL    = 8u;
const uint SODIUM_FLAG_DIAG_SKIP_STAMPS = 16u;
// One indirect draw per buffer group (SodiumTerrainDrawer.PROPERTY_ONE_DRAW):
// the workgroup finds its region by searching the group's entries on
// groupEnd; RegionCount (push) is the group's entry count.
const uint SODIUM_FLAG_ONE_DRAW         = 32u;
// Phase A also draws what was marked TWO frames ago
// (SodiumGpuVisibilityLayout.FLAG_STAMP_HOLD). CurStamps is the other
// ping-pong buffer and phase A runs BEFORE this frame's section raster
// writes it, so at pass 1a/1b it still holds frame-2's marks.
const uint SODIUM_FLAG_STAMP_HOLD       = 64u;
// Take the row from the list entry, not the mirror
// (SodiumGpuVisibilityLayout.FLAG_ROWS_FROM_LIST).
const uint SODIUM_FLAG_ROWS_FROM_LIST   = 128u;
const uint SODIUM_ROW_FLAG_LIVE  = 1u;   // SodiumGpuVisibilityLayout.ROW_FLAG_LIVE
#else
// Tiny GPU stats: [VisMode] += 1 per section that survives all gates —
// the wave-6 readback consumer (TerrainOcclusion copies + zeroes it each
// stats frame). [0] = mask mode, [1] = phase A, [2] = phase B.
layout(set = 0, binding = 11, std430) buffer OccStats {
    uint occStats[4];
};

// Per-draw data (one draw = one region).
layout(push_constant) uniform MesheliumPush {
    vec3 OriginRelCamera;  // REGION origin (block coords) minus camera pos
    uint RegionIndex;      // Meshelium region id = section-record block index
    uint MaskSlot;         // VisMode 0: visMasks slice, or 0xFFFFFFFF = no
                           // mask (fail OPEN — also the occlusion-overflow
                           // path: regions beyond the occlusion list cap
                           // draw all sections in phase A)
    uint VisMode;          // 0 = BFS mask (wave 5) / 1 = occlusion phase A
                           // (visible last frame) / 2 = occlusion phase B
                           // (just became visible this frame)
    uint FrameStamp;       // this frame's occlusion stamp (VisMode 1/2)
    uint StatsFlags;       // bit 0: count surviving sections into occStats
};
#endif

// One entry per task invocation (= per compacted section slot).
struct MesheliumSectionTask {
    uint groupEnd;      // after the prefix pass: cumulative mesh-workgroup
                        // end over this task workgroup's sections
    uint posAndCount;   // bits 0-7 = posKey within the region,
                        // bits 8-31 = surviving quad count
    uvec4 binIa;        // cumulative surviving-quad END index, bins 0-3
    uvec4 binIb;        // bins 4-7 (unused bins stay 0)
    uvec4 binVa;        // ABSOLUTE arena quad index of each bin's start
    uvec4 binVb;
};

struct MesheliumTaskPayload {
    MesheliumSectionTask sections[MESHELIUM_TASK_WG_SIZE];
#if MESHELIUM_SODIUM_TASK
    // The region origin travels in the payload instead of a push constant
    // because one draw now covers many regions. +16 B; terrain.mesh's
    // declaration must match byte for byte, and TerrainDrawPipeline
    // .createSodiumTask asserts 80 * MESHELIUM_TASK_WG_SIZE + 16 against
    // the device's maxTaskPayloadSize.
    vec4 regionOrigin;
#endif
};

// taskPayloadSharedEXT qualifies a VARIABLE of struct type (the EXT spec's
// form) — not an interface block.
taskPayloadSharedEXT MesheliumTaskPayload payload;

// The exact test vanilla runs: JOML FrustumIntersection.testAab's p-vertex
// form, keep iff dot(n, p) >= -w for all six planes, p selecting the max
// corner where the plane coefficient is >= 0 (bytecode-verified).
bool inFrustum(vec3 lo, vec3 hi) {
    for (int i = 0; i < 6; ++i) {
        vec4 plane = FrustumPlanes[i];
        vec3 p = mix(lo, hi, greaterThanEqual(plane.xyz, vec3(0.0)));
        if (dot(plane.xyz, p) < -plane.w) {
            return false;
        }
    }
    return true;
}

// task_common.glsl's putBinData, EXT-shaped: bins fill densely in walk
// order; binI holds cumulative end indices, binV absolute arena starts.
void putBin(inout uint idx, inout uint lastIndex, uint absStart, uint len, uint t) {
    uint id = idx++;
    if (id < 4u) {
        payload.sections[t].binIa[id] = lastIndex + len;
        payload.sections[t].binVa[id] = absStart;
    } else {
        payload.sections[t].binIb[id - 4u] = lastIndex + len;
        payload.sections[t].binVb[id - 4u] = absStart;
    }
    lastIndex += len;
}

#if MESHELIUM_SODIUM_TASK
// The k-th set bit of a 256-bit occupancy mask (word i covers slots
// 32i..32i+31): per word, if k < bitCount, clear k low set bits with
// x &= x-1 and take findLSB; else subtract and move on. The SAME text is
// duplicated in occlusion/section_raster.mesh (no #include exists in
// MesheliumShaderCompiler) - keep the two identical. Returns 255 only for
// k >= popcount, which the caller's k < row.popcount check excludes.
uint meshelium_sodiumSlotOfRank(uvec4 m0, uvec4 m1, uint k) {
    uint w[8] = uint[8](m0.x, m0.y, m0.z, m0.w, m1.x, m1.y, m1.z, m1.w);
    for (uint i = 0u; i < 8u; ++i) {
        uint c = uint(bitCount(w[i]));
        if (k < c) {
            uint x = w[i];
            for (uint j = 0u; j < k; ++j) {
                x &= x - 1u;
            }
            return i * 32u + uint(findLSB(x));
        }
        k -= c;
    }
    return 255u;
}

// OcclusionCuller.nearestToZero(a, b) = a > 0 ? a : (b < 0 ? b : 0)
// (contract §1.4, bytecode @0-15).
int meshelium_sodiumNearestToZero(int a, int b) {
    return a > 0 ? a : (b < 0 ? b : 0);
}

// One of Sodium's seven facing runs, MesheliumSodiumDrawList.emitRuns'
// loop body: a populated run whose facing the camera can see becomes a
// bin of count/4 quads starting at the current VERTEX cursor; the cursor
// advances over EVERY run, kept or culled - skipping the advance draws
// the wrong geometry, not less of it (D-010's trap). The facing byte of
// an empty run is never consulted (count != 0 is tested first), and the
// shift count is masked to 5 bits exactly as Java's >>> masks it, so an
// out-of-range byte keeps or drops precisely what the list path would.
void meshelium_sodiumRun(uint count, uint facing, uint mask,
        inout uint cursor, inout uint idx, inout uint lastIndex, uint t) {
    if (count != 0u && ((mask >> (facing & 31u)) & 1u) != 0u) {
        putBin(idx, lastIndex, cursor, count >> 2u, t);
    }
    cursor += count;
}
#endif

void main() {
    uint t = gl_LocalInvocationIndex;
#if MESHELIUM_SODIUM_TASK
    // ---- Sodium arm: lane k of the region at list slot FirstSlot +
    // gl_DrawIDARB. Every address below the record reads is uniform
    // across the workgroup (draw index + workgroup-uniform mid), so the
    // row loads are scalar loads out of the constant cache - the shape
    // the batched mesh stage measured 0.5 ms/frame for getting wrong.
    uint slot;
    uint localWg;
    if ((Flags & SODIUM_FLAG_ONE_DRAW) != 0u) {
        // One draw covers the group's [FirstSlot, FirstSlot + RegionCount)
        // entries; workgroup g belongs to the first entry whose cumulative
        // groupEnd exceeds g (an entry with no workgroups has groupEnd ==
        // its predecessor's and is never selected). Uniform inputs, so
        // scalar loads; RegionCount >= 1 whenever the group is drawn.
        uint g = gl_WorkGroupID.x;
        uint lo = FirstSlot;
        uint hi = FirstSlot + RegionCount - 1u;
        while (lo < hi) {
            uint m = (lo + hi) >> 1u;
            if (list[m].groupEnd > g) {
                hi = m;
            } else {
                lo = m + 1u;
            }
        }
        slot = lo;
        uint start = (slot == FirstSlot) ? 0u : list[slot - 1u].groupEnd;
        localWg = g - start;
    } else {
        slot = FirstSlot + uint(gl_DrawIDARB);
        localWg = gl_WorkGroupID.x;
    }
    OccRegion e = list[slot];
    uint mid = e.meta.x;
    uint k = localWg * uint(MESHELIUM_TASK_WG_SIZE) + t;

    // NO early returns: EmitMeshTasksEXT and barrier() below demand that
    // every invocation arrives (uniform control flow).
    uint groups = 0u;

    // Measurement only: with DIAG_SKIP_ALL set, no row, record or stamp
    // is read and nothing is emitted - the launch and payload cost alone.
    if ((Flags & SODIUM_FLAG_DIAG_SKIP_ALL) == 0u) {
    uvec4 r0;   // ivec4 {chunkX, chunkY, chunkZ, flags}
    uvec4 r1;   // occupancy words 0-3
    uvec4 r2;   // occupancy words 4-7
    uvec4 r3;   // {bufferKey, popcount, occMin, occMax}
    if ((Flags & SODIUM_FLAG_ROWS_FROM_LIST) != 0u) {
        // The row the processor wrote into this frame's list entry. The
        // list is rewritten every frame and has never been read stale;
        // the mirror's copy of the same 64 bytes was, for many frames at
        // a time, on the owner's RADV laptop.
        r0 = e.row0;
        r1 = e.row1;
        r2 = e.row2;
        r3 = e.row3;
        if ((Flags & SODIUM_FLAG_STATS) != 0u && t == 0u) {
            // Measure the thing being worked around: does the mirror still
            // disagree with the fresh copy? Once per workgroup, never
            // acted on.
            uvec4 m3 = data[mid * 4u + 3u];
            if (m3.x != r3.x || m3.y != r3.y) {
                uint seen = atomicAdd(stats[19], 1u);
                if (seen == 0u) {
                    stats[20] = mid;
                    stats[21] = m3.x;
                    // Key and popcount of the fresh copy, packed, so the
                    // log can say which side is the newer one (keys stay
                    // well under 65536; a popcount is at most 256).
                    stats[22] = (r3.x << 16u) | (r3.y & 0xFFFFu);
                    stats[23] = m3.y;
                }
            }
        }
    } else {
        r0 = data[mid * 4u + 0u];
        r1 = data[mid * 4u + 1u];
        r2 = data[mid * 4u + 2u];
        r3 = data[mid * 4u + 3u];
    }

    // The group check (contract I4, §5.4 step 2): a row whose key is not
    // the buffer bound at binding 0 for this draw emits nothing. A dead
    // row (live bit clear, or zero-filled after delete) emits nothing.
    bool rowLive = (r0.w & SODIUM_ROW_FLAG_LIVE) != 0u;
    bool keyOk = r3.x == GroupKey;
    // The record probe (SodiumGpuVisibilityLayout.LIST_ROW_PROBE_*). With
    // the row taken from the list the key check above cannot fail, so this
    // is what now guarantees the section records on the card belong to the
    // commit the row describes: the first occupied section's base vertex,
    // read from the card, must equal what the processor committed. A
    // mismatch refuses the region - a hole, never old offsets drawn out of
    // a new geometry buffer.
    uint cardProbe = 0u;
    uint wantProbe = 0u;
    bool recOk = true;
    if ((Flags & SODIUM_FLAG_ROWS_FROM_LIST) != 0u && rowLive && r3.y != 0u) {
        uint s0 = meshelium_sodiumSlotOfRank(r1, r2, 0u);
        cardProbe = data[RecordBase + (mid * 256u + s0) * 3u].y;
        wantProbe = (RecordPass == 0u) ? r3.z : r3.w;
        recOk = cardProbe == wantProbe;
    }
    bool regionOk = rowLive && keyOk && recOk;
    // Every workgroup this draw dispatched belongs to a region OF THIS
    // GROUP, so in normal operation the gate never rejects: the CPU put the
    // region in this group precisely because its key is the group's, and it
    // declines the whole frame if its own shadow disagrees. A rejection
    // therefore means the row on the card is not the row the CPU believes
    // it wrote, and it costs the WHOLE region - which is what an 8x4x8
    // hole looks like from the inside. Counted once per workgroup, by
    // cause, so the log can tell a dead row from a stale key.
    if (!regionOk && (Flags & SODIUM_FLAG_STATS) != 0u) {
        uint before = atomicAdd(stats[4], 1u);
        if (!rowLive) {
            atomicAdd(stats[5], 1u);
        } else {
            atomicAdd(stats[6], 1u);
        }
        if (before == 0u) {
            // The first refusal of the frame writes down what it was
            // looking at. Exactly one invocation sees a pre-increment of
            // zero, so these eight words are one coherent snapshot and not
            // a mixture; every later refusal only moves the counts.
            stats[8]  = mid;
            stats[9]  = r3.x;         // the key the row on the card holds
            stats[10] = GroupKey;     // the key this draw is for
            stats[11] = slot;         // the list entry it read
            stats[12] = FirstSlot;    // the group's first entry
            stats[13] = RegionCount;  // entries in the group (one-draw only)
            // With the rows from the list, the key cannot mismatch and a
            // refusal is the record probe: what the processor committed
            // against what the card holds. Otherwise the two popcounts.
            bool fromList = (Flags & SODIUM_FLAG_ROWS_FROM_LIST) != 0u;
            stats[14] = fromList ? wantProbe : e.meta.y;
            stats[15] = fromList ? cardProbe : r3.y;
            // Where the row says it is. The processor keeps its own record
            // of what it last wrote for this id, so these three words
            // settle whether this is an older copy of the RIGHT row or
            // some other region's row read by mistake.
            stats[16] = r0.x;
            stats[17] = r0.y;
            stats[18] = r0.z;
            stats[7]  = VisMode;      // which of the four draws refused
        }
    }
    if (regionOk && k < r3.y) {
        uint slot = meshelium_sodiumSlotOfRank(r1, r2, k);
        // LocalSectionIndex.pack(x,y,z) = (x&7)<<5 | (y&3) | (z&7)<<2.
        uint lx = (slot >> 5u) & 7u;
        uint ly = slot & 3u;
        uint lz = (slot >> 2u) & 7u;

        // VisMode 0: the BFS-parity bit (the list entry's mask, drained
        // from Sodium's sectionsWithGeometryIterator for this region).
        // VisMode 1/2: the standalone arm's stamp tests verbatim - drawn
        // iff prev==FrameStamp-1 (A) or cur==FrameStamp && !prevFresh (B);
        // union = every marked section, intersection empty, staleness
        // can only ADD a depth-tested draw of a current record (I5).
        bool visible;
        if (VisMode == 0u) {
            uint w = slot >> 5u;
            uint word = (w < 4u) ? e.mask0[w] : e.mask1[w - 4u];
            visible = ((word >> (slot & 31u)) & 1u) != 0u;
        } else if ((Flags & SODIUM_FLAG_DIAG_SKIP_STAMPS) != 0u) {
            visible = false;   // measurement only: the stamp loads priced out
        } else {
            uint gidx = mid * 256u + slot;
            bool prevFresh = prevStamps[gidx] == FrameStamp - 1u;
            if (VisMode == 1u) {
                // Phase A: marked last frame, or - with the hold - marked
                // the frame before that. The second term reads the buffer
                // THIS frame's raster has not written yet, which still
                // holds FrameStamp-2, so a single frame with no marks for
                // this region no longer takes it off the screen.
                visible = prevFresh || ((Flags & SODIUM_FLAG_STAMP_HOLD) != 0u
                        && curStamps[gidx] == FrameStamp - 2u);
            } else {
                // Phase B: marked this frame and not last. The hold is NOT
                // repeated here and cannot be: by pass 4 the raster has
                // overwritten curStamps with FrameStamp, so the value phase
                // A tested is gone. A section that phase A drew through the
                // hold and the raster has now marked is therefore drawn
                // twice in this frame - identical opaque geometry at
                // identical depth, so identical pixels, and only for the
                // handful of sections that lost a frame of marks.
                visible = curStamps[gidx] == FrameStamp && !prevFresh;
            }
        }

        if (visible) {
            // Frustum: the full 16³ box inflated 0.5 blocks, the
            // pixel-safe superset the standalone arm uses (see (a) above).
            vec3 lo = e.origin + vec3(float(lx), float(ly), float(lz)) * 16.0 - 0.5;
            // VisMode 0: no frustum here — every masked section already passed
            // Sodium's own test (TraversableTree.testLeafNode ->
            // Viewport.isBoxVisibleDirect(x,y,z, 9.125f) against the CULL
            // frustum, a superset of this render-frustum box), and Sodium draws
            // that list with no draw-time frustum either; applying this gate
            // would make the drawn set a strict subset of the list path's and
            // break the 97_01 counter equality. VisMode 1/2 keep it: their
            // section set comes from the stamps, not from a Sodium-tested list.
            if (VisMode == 0u || inFrustum(lo, lo + 17.0)) {
                ivec3 sc = ivec3(r0.xyz) + ivec3(int(lx), int(ly), int(lz));
                ivec3 cam = CameraBlock.xyz;

                // Distance (VisMode 1/2 only - the CPU sets DIST_GATE):
                // OcclusionCuller.visitNode's test, contract §1.4 / §6.3.
                // Per axis d = sectionOrigin - cam.int (blocks), n =
                // float(nearestToZero(d-1, d+17)) - cam.frac; keep iff
                // n.x²+n.z² < D² and |n.y| < D. `precise` forbids FMA
                // contraction so distSq is Java's fmul, fmul, fadd.
                bool inRange = true;
                if ((Flags & SODIUM_FLAG_DIST_GATE) != 0u) {
                    ivec3 d = (sc << 4) - cam;
                    precise float nx = float(meshelium_sodiumNearestToZero(d.x - 1, d.x + 17)) - CameraFrac.x;
                    precise float ny = float(meshelium_sodiumNearestToZero(d.y - 1, d.y + 17)) - CameraFrac.y;
                    precise float nz = float(meshelium_sodiumNearestToZero(d.z - 1, d.z + 17)) - CameraFrac.z;
                    precise float distSq = nx * nx + nz * nz;
                    float D = CameraFrac.w;
                    inRange = distSq < D * D && abs(ny) < D;
                }

                if (inRange) {
                    // Facing: DefaultChunkRenderer.getVisibleFaces
                    // (contract §1.4, bytecode @0-149) as six integer
                    // comparisons - origin = coord<<4, end = origin+16,
                    // POS_axis kept iff cam > origin-3, NEG_axis iff cam
                    // < end+3, UNASSIGNED always. Ordinals POS_X 0, POS_Y
                    // 1, POS_Z 2, NEG_X 3, NEG_Y 4, NEG_Z 5, UNASSIGNED 6.
                    // FACE_ALL = the list path's "faceCull off" (mask =
                    // ModelQuadFacing.ALL, 0x7F).
                    uint mask = 1u << 6u;
                    if ((Flags & SODIUM_FLAG_FACE_ALL) != 0u) {
                        mask = 0x7Fu;
                    } else {
                        ivec3 o = sc << 4;
                        ivec3 en = o + 16;
                        mask |= (uint(cam.x > o.x - 3) << 0u)
                              | (uint(cam.y > o.y - 3) << 1u)
                              | (uint(cam.z > o.z - 3) << 2u)
                              | (uint(cam.x < en.x + 3) << 3u)
                              | (uint(cam.y < en.y + 3) << 4u)
                              | (uint(cam.z < en.z + 3) << 5u);
                    }

                    // The record walk (emitRuns line for line). Facing of
                    // run i = byte 8+i: i < 4 in w0.z at bits 8i, else in
                    // w0.w at bits 8(i-4); byte 15 (isLocalIndex) is never
                    // read because i <= 6. Adjacent kept runs are NOT
                    // merged - each is its own bin (at most 7; the payload
                    // holds 8).
                    uint base = RecordBase + (mid * 256u + slot) * 3u;
                    uvec4 w0 = data[base];
                    uvec4 w1 = data[base + 1u];
                    uvec4 w2 = data[base + 2u];
                    uint cursor = w0.y;                // baseVertex, VERTEX units
                    uint idx = 0u;
                    uint lastIndex = 0u;
                    payload.sections[t].binIa = uvec4(0u);
                    payload.sections[t].binIb = uvec4(0u);
                    meshelium_sodiumRun(w1.y, (w0.z       ) & 0xFFu, mask, cursor, idx, lastIndex, t); // run 0
                    meshelium_sodiumRun(w1.z, (w0.z >>  8u) & 0xFFu, mask, cursor, idx, lastIndex, t); // run 1
                    meshelium_sodiumRun(w1.w, (w0.z >> 16u) & 0xFFu, mask, cursor, idx, lastIndex, t); // run 2
                    meshelium_sodiumRun(w2.x, (w0.z >> 24u) & 0xFFu, mask, cursor, idx, lastIndex, t); // run 3
                    meshelium_sodiumRun(w2.y, (w0.w       ) & 0xFFu, mask, cursor, idx, lastIndex, t); // run 4
                    meshelium_sodiumRun(w2.z, (w0.w >>  8u) & 0xFFu, mask, cursor, idx, lastIndex, t); // run 5
                    meshelium_sodiumRun(w2.w, (w0.w >> 16u) & 0xFFu, mask, cursor, idx, lastIndex, t); // run 6

                    if (lastIndex > 0u) {
                        // Repacked into Meshelium's posKey layout (y bits
                        // 6-7, z bits 3-5, x bits 0-2) so terrain.mesh's
                        // decode is unchanged.
                        payload.sections[t].posAndCount = (lastIndex << 8u) | ((ly << 6u) | (lz << 3u) | lx);
                        groups = (lastIndex + uint(MESHELIUM_WG_SIZE) - 1u) / uint(MESHELIUM_WG_SIZE);
                        if ((Flags & SODIUM_FLAG_STATS) != 0u) {
                            atomicAdd(stats[VisMode], 1u);
                            atomicAdd(stats[3], lastIndex);
                        }
                    }
                }
            }
        }
    }
    } // DIAG_SKIP_ALL
    if (t == 0u) {
        payload.regionOrigin = vec4(e.origin, 0.0);
    }
#else
    uint slot = gl_WorkGroupID.x * uint(MESHELIUM_TASK_WG_SIZE) + t;
    uint recordBase = (RegionIndex * 256u + slot) * 2u;
    ivec4 header = sectionRecords[recordBase];
    ivec4 rangesI = sectionRecords[recordBase + 1u];

    // NO early returns: EmitMeshTasksEXT and barrier() below demand that
    // every invocation arrives (uniform control flow).
    uint groups = 0u;

    // Empty-slot check: a live section can never have terrainAddress 0
    // (quad 0 is reserved — SectionRecord javadoc), and all-zero records
    // are the tombstone/trailing-slot state.
    if (header.w != 0) {
        // Chunk coords: 24-bit signed at bits 8-31 (arithmetic >> 8), 9-bit
        // signed chunkY at bits 8-16 (terrain/task.glsl:41-43's sign extend).
        int chunkX = header.x >> 8;
        int chunkY = (header.y << 15) >> 23;
        int chunkZ = header.z >> 8;
        uint posKey = uint(((chunkY & 3) << 6) | ((chunkZ & 7) << 3) | (chunkX & 7));

        // (c) the visibility source — three modes since wave 6:
        //   VisMode 0: the vanilla-BFS mask bit (wave 5, the bfsOnly
        //              fallback); 0xFFFFFFFF fails open.
        //   VisMode 1: occlusion phase A — visible LAST frame (the stamp
        //              the previous frame's section raster wrote). Draws
        //              last frame's visible set, priming this frame's
        //              depth for the raster — Nvidium's phase 1.
        //   VisMode 2: occlusion phase B — JUST became visible (marked by
        //              THIS frame's raster, not marked last frame) —
        //              Nvidium's temporal_task predicate (vis&3)==1
        //              (temporal_task.glsl:23-26), stamp-shaped.
        // A section is drawn this frame iff prev==FrameStamp-1 (A) OR
        // cur==FrameStamp ∧ prev!=FrameStamp-1 (B): the union covers every
        // raster-marked section, the intersection is empty (no double
        // draw), and staleness in either buffer can only ADD a draw of a
        // real, current record — never remove one (the parity guard).
        bool visible = true;
        if (VisMode == 0u) {
            if (MaskSlot != 0xFFFFFFFFu) {
                uvec4 words = visMasks[MaskSlot * 2u + (posKey >> 7u)];
                visible = ((words[(posKey >> 5u) & 3u] >> (posKey & 31u)) & 1u) != 0u;
            }
        } else {
            uint gidx = RegionIndex * 256u + slot;
            bool prevFresh = prevStamps[gidx] == FrameStamp - 1u;
            if (VisMode == 1u) {
                visible = prevFresh;
            } else {
                visible = curStamps[gidx] == FrameStamp && !prevFresh;
            }
        }

        if (visible) {
            // (a) frustum: full 16³ section box (wave-4 parity precedent),
            // camera-relative, inflated 0.5 blocks so CPU-vs-GPU float
            // rounding can only ever over-include.
            vec3 lo = OriginRelCamera
                    + vec3(float(posKey & 7u), float(posKey >> 6u), float((posKey >> 3u) & 7u)) * 16.0
                    - 0.5;
            if (inFrustum(lo, lo + 17.0)) {
                // (d) facing buckets — task_common.glsl:30-78's walk, signs
                // and order pinned by QuadFacing/MesheliumTerrainDataTest.
                ivec3 rel = ivec3(chunkX, chunkY, chunkZ) - CameraChunk.xyz;
                uvec4 ranges = uvec4(rangesI);
                uint base = uint(header.w);
                uint fr = (ranges.w >> 16) & 0xFFFFu; // skip translucent prefix
                uint idx = 0u;
                uint lastIndex = 0u;
                payload.sections[t].binIa = uvec4(0u);
                payload.sections[t].binIb = uvec4(0u);

                uint delta = ranges.x & 0xFFFFu;                    // POS_X
                if (rel.x <= 0 && delta > 0u) putBin(idx, lastIndex, base + fr, delta, t);
                fr += delta;
                delta = (ranges.x >> 16) & 0xFFFFu;                 // POS_Y
                if (rel.y <= 0 && delta > 0u) putBin(idx, lastIndex, base + fr, delta, t);
                fr += delta;
                delta = ranges.y & 0xFFFFu;                         // POS_Z
                if (rel.z <= 0 && delta > 0u) putBin(idx, lastIndex, base + fr, delta, t);
                fr += delta;
                delta = (ranges.y >> 16) & 0xFFFFu;                 // NEG_X
                if (rel.x >= 0 && delta > 0u) putBin(idx, lastIndex, base + fr, delta, t);
                fr += delta;
                delta = ranges.z & 0xFFFFu;                         // NEG_Y
                if (rel.y >= 0 && delta > 0u) putBin(idx, lastIndex, base + fr, delta, t);
                fr += delta;
                delta = (ranges.z >> 16) & 0xFFFFu;                 // NEG_Z
                if (rel.z >= 0 && delta > 0u) putBin(idx, lastIndex, base + fr, delta, t);
                fr += delta;
                delta = ranges.w & 0xFFFFu;                         // UNASSIGNED
                // Cull Tiny Plants Beyond (default OFF): the UNASSIGNED
                // bucket is the cross-model geometry (grass tufts,
                // flowers) — no merge plane, no camera-side gate above,
                // and sub-pixel long before any distance a player can set.
                // lo (above) is the section's camera-relative min corner
                // minus the 0.5 inflation, so lo + 8.5 is its center; the
                // bucket is kept while the center's distance squared stays
                // within CullMisc.x. With the slider at 0 the CPU uploads
                // 3.4e38 and every finite distance passes, making this
                // line behave exactly like the unconditional emit it
                // replaced (bins, counts and payload bit-identical).
                vec3 plantCullCenter = lo + 8.5;
                if (delta > 0u && dot(plantCullCenter, plantCullCenter) <= CullMisc.x) {
                    putBin(idx, lastIndex, base + fr, delta, t);
                }

                if (lastIndex > 0u) {
                    payload.sections[t].posAndCount = (lastIndex << 8u) | posKey;
                    groups = (lastIndex + uint(MESHELIUM_WG_SIZE) - 1u) / uint(MESHELIUM_WG_SIZE);
                    if ((StatsFlags & 1u) != 0u) {
                        // Wave-6 stats: one atomic per DRAWN section (a
                        // few thousand/frame — noise). Guarded by the push
                        // flag so bfs/cpu frames without occlusion
                        // resources never touch the (dummy) binding.
                        atomicAdd(occStats[VisMode], 1u);
                    }
                }
            }
        }
    }
#endif

    payload.sections[t].groupEnd = groups;
    barrier();
    if (t == 0u) {
        // Serial prefix over MESHELIUM_TASK_WG_SIZE entries — trivial work,
        // zero portability assumptions (no subgroup size dependence).
        uint sum = 0u;
        for (uint i = 0u; i < uint(MESHELIUM_TASK_WG_SIZE); ++i) {
            sum += payload.sections[i].groupEnd;
            payload.sections[i].groupEnd = sum;
        }
    }
    barrier();
    EmitMeshTasksEXT(payload.sections[MESHELIUM_TASK_WG_SIZE - 1].groupEnd, 1u, 1u);
}
