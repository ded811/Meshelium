		"issues": "https://github.com/ded811/Meshelium/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/meshelium/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.deds.meshelium.fabric.MesheliumClient"
		]
	},
	"mixins": [
		"meshelium.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
